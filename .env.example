# URL interne du qBittorrent WebUI, accessible depuis le réseau Docker sélectionné.
QBIT_URL=http://192.168.1.10:8080
QBIT_USERNAME=
QBIT_PASSWORD=
# Mot de passe pour accéder à l'interface du contrôleur
ADMIN_PASSWORD=REMPLACER_PAR_UN_LONG_MOT_DE_PASSE

# Réseau Docker EXISTANT : bridge par défaut ; exemple : br0 ou mon_reseau
DOCKER_NETWORK=bridge
# Port hôte exposé par Unraid, port interne toujours 8788
WEBUI_PORT=8788

# 1 uniquement si le site est servi en HTTPS (ex. reverse proxy TLS)
# En HTTP local, conserver 0 ; les cookies Secure ne seraient pas renvoyés.
COOKIE_SECURE=0

# Utilisateur du processus (Unraid : nobody=99, users=100). /data lui est attribué au démarrage.
PUID=99
PGID=100

# Fichiers .torrent (ils contiennent souvent des passkeys : pas de lecture pour « autres »).
TORRENT_UID=99
TORRENT_GID=100
TORRENT_FILE_MODE=0660
TORRENT_DIR_MODE=0770

# IP du reverse proxy autorisé à transmettre X-Forwarded-For (anti-brute-force par vraie IP).
# Laisser vide sans reverse proxy. Plusieurs IP : séparer par des virgules.
TRUSTED_PROXIES=

# Dossier surveillé : les .torrent déposés dans data/import/ sont importés automatiquement.
IMPORT_WATCH=1
# Rotation des journaux JOAL (runtime/*/joal.log) : taille max par fichier et nombre d'archives.
LOG_MAX_MB=5
LOG_BACKUPS=3
# Fuseau horaire pour les plages horaires des règles (Unraid le fournit automatiquement).
TZ=Europe/Brussels

# Mémoire MINIMALE de chaque JVM JOAL (une par règle active). Défaut : 128m. Depuis v1.29.3,
# elle est augmentée automatiquement selon la taille des .torrent de la session (jusqu'à 1536m).
JOAL_XMX=128m
# Options Java complètes (remplace JOAL_XMX si renseigné). Laisser vide par défaut.
JOAL_JAVA_OPTS=
